{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep, all
 ;; .cljc → portable to JVM / SCI / ClojureScript / GraalVM). Both live in
 ;; the kotoba-lang org of this workspace (kotoba wasm → clojurewasm →
 ;; ClojureScript → nbb runtime priority, CLAUDE.md).
 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.robotics.process: the process-physics solvers and probe this
        ;; repo's physics.edn runs on (physical-AI bot, scripts/physical-ai-bots).
        io.github.kotoba-lang/robotics {:local/root "../../kotoba-lang/robotics"}

        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}}
 :aliases
 {
  ;; kbb -M:physics -> the physical-AI bot's measurement: runs physics.edn on
  ;; kotoba.robotics.process and prints one probe map. Exit 2 = could not measure.
  :physics {:main-opts ["-m" "kotoba.robotics.process.probe"]}
  ;; kbb -M:physai-test -> test/'s .cljk on kbb's runner (the bot's test count;
  ;; a .kotoba vertical's own :test may refuse kbb on purpose).
  ;; test/ is left out here: hazmat.*-kotoba-parity-test need the kotoba
  ;; compiler (the JVM :test alias) and cannot load on kbb.
  :physai-test {:extra-paths ["test-physai"] :main-opts ["-m" "cognitect.test-runner"]}
;; offline workspace dev — pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; kbb -M:dev:run  → drive the demo through one OperationActor
  :run {:main-opts ["-m" "hazmat.sim"]}
  ;; The Kotoba compiler and the KIR interpreter are TEST-ONLY. They exist for
  ;; the .kotoba parity gates — `hazmat.phase-kotoba-parity-test` over
  ;; `src/hazmat/phase_core.kotoba` (a decision-core fallback: the phase gate
  ;; needed a BigDecimal weight) and `hazmat.report-kotoba-parity-test` over
  ;; `src/hazmat/report_disclosure.kotoba` (not a fallback: the disclosure gate
  ;; is written in full, in strings, on all three targets). Each test compiles
  ;; the .kotoba and executes it, so nothing in `src/` requires either and this
  ;; alias cannot change what the actor does. Measured 2026-08-30:
  ;; `grep -rn "kotoba\\.compiler\\|kotoba\\.kir" src` is empty.
  ;;
  ;; `compiler.git` redirects at GitHub to `kotoba-lang/amu`. Pinned rather
  ;; than floated, and pinned to the SAME pair `cloud-itonami-app` uses for its
  ;; own cores: KIR is a versioned document, and an interpreter reading a shape
  ;; its emitter did not write is the failure the pin exists to remove.
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      io.github.kotoba-lang/compiler
                      {:git/url "https://github.com/kotoba-lang/compiler.git"
                       :git/sha "1644b326eefa0951a6343cee9aff88fe9ba745e2"}
                      io.github.kotoba-lang/osaho
                      {:git/url "https://github.com/kotoba-lang/osaho.git"
                       :git/sha "da24cae65e82f91352c5b96b0c58f21a52911277"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis — clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
